@page "/calcylator"

<PageTitle>Calcylator</PageTitle>

<h1>Miniräknare</h1>

<p>
    <input type="number" @bind="number1" placeholder="Första talet"/>
    <input type="number" @bind="number2" placeholder="Andra talet"/>
</p>


<p>
    <button class="btn btn-primary" @onclick="Addition">+</button>
    <button class="btn btn-primary" @onclick="Subtract">-</button>
    <button class="btn btn-primary" @onclick="Multiplikation">*</button>
    <button class="btn btn-primary" @onclick="Divide">/</button>
</p>

<p>Resultat: @result</p>

@code {

    private double number1;
    private double number2;
    private double result;


    private void Addition()
    {
        result = number1 + number2; 
    }

    private void Subtract()
    {
        result = number1 - number2;
    }

    private void Multiplikation()
    {
        result = number1 * number2;
    }

    private void Divide()
    {
        result = number1 / number2;
    }

}

